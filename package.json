{
  "name": "formfusion",
  "version": "1.1.9",
  "description": "Efficient and adaptable form management solution featuring out-of-the-box validation.",
  "private": false,
  "scripts": {
    "build": "find . -mindepth 1 -maxdepth 1 -type d ! -name 'node_modules' ! -name 'src' ! -name 'plugins' -exec sh -c 'find \"{}\" -type f -name \"*.js\" | read' \\; -exec rm -rf {} \\; && node esbuild.js",
    "test": "jest src/tests/*.test.jsx",
    "prefix-css": "postcss src/style.css -u autoprefixer -o ./style.css --no-map",
    "minify-css": "postcss style.css -u cssnano -o style.css --no-map",
    "version": "conventional-changelog -p -i CHANGELOG.md -s -r 0",
    "publish-package": "npm publish --access public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mitevskasara/formfusion.git"
  },
  "keywords": [
    "react",
    "javascript",
    "typescript",
    "forms",
    "validation",
    "form-validation"
  ],
  "main": "index.js",
  "module": "index.js",
  "types": "index.d.ts",
  "author": "Sara Mitevska",
  "license": "BSD-2-Clause license",
  "bugs": {
    "url": "https://github.com/corelabui/formfusion/issues"
  },
  "homepage": "https://www.corelabui.com/formfusion",
  "peerDependencies": {},
  "devDependencies": {
    "@babel/preset-react": "^7.23.3",
    "@testing-library/jest-dom": "^6.4.2",
    "@testing-library/react": "^14.2.1",
    "autoprefixer": "^10.4.19",
    "esbuild": "^0.18.10",
    "jest": "^29.7.0",
    "jest-environment-jsdom": "^29.7.0",
    "postcss": "^8.4.38",
    "postcss-cli": "^11.0.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0"
  },
  "jest": {
    "testEnvironment": "jsdom",
    "transform": {
      "\\.(js|jsx)$": "babel-jest"
    }
  }
}