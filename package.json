{
  "name": "formfusion",
  "version": "1.2.0",
  "description": "Efficient and adaptable form management solution featuring out-of-the-box validation.",
  "private": false,
  "scripts": {
    "build-js": "find . -mindepth 1 -maxdepth 1 -type d ! -name 'node_modules' ! -name 'src' ! -name 'plugins' -exec sh -c 'find \"{}\" -type f -name \"*.js\" | read' \\; -exec rm -rf {} \\; && node esbuild.js",
    "test": "jest",
    "prefix-css": "postcss src/style.css -u autoprefixer -o ./style.css --no-map",
    "minify-css": "postcss style.css -u cssnano -o style.css --no-map",
    "version": "conventional-changelog -p -i CHANGELOG.md -s -r 0",
    "build": "npm run prefix-css && npm run minify-css && npm run build-js",
    "publish-package": "npm publish --access public",
    "format": "prettier --write .",
    "check-format": "prettier --check ."
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mitevskasara/formfusion.git"
  },
  "keywords": [
    "react",
    "javascript",
    "typescript",
    "forms",
    "validation",
    "form-validation"
  ],
  "main": "index.js",
  "module": "index.mjs",
  "types": "index.d.ts",
  "exports": {
    ".": {
      "types": "./index.d.ts",
      "import": "./index.mjs",
      "require": "./index.js",
      "default": "./index.js"
    },
    "./style.css": "./style.css",
    "./package.json": "./package.json"
  },
  "sideEffects": [
    "*.css"
  ],
  "files": [
    "index.js",
    "index.mjs",
    "index.d.ts",
    "style.css",
    "CHANGELOG.md",
    "README.md"
  ],
  "peerDependencies": {
    "react": ">=16.8.0"
  },
  "author": "Sara Mitevska",
  "license": "BSD-2-Clause license",
  "bugs": {
    "url": "https://github.com/mitevskasara/formfusion/issues"
  },
  "homepage": "https://formfusion.dev",
  "devDependencies": {
    "@babel/preset-env": "^7.26.0",
    "@babel/preset-react": "^7.23.3",
    "@formfusion/licence-plates": "^1.0.2",
    "@formfusion/postcodes": "^1.0.2",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.3.3",
    "autoprefixer": "^10.6.1",
    "cssnano": "^9.4.0",
    "esbuild": "^0.28.2",
    "jest": "^30.5.2",
    "jest-environment-jsdom": "^30.5.2",
    "postcss": "^8.5.0",
    "postcss-cli": "^12.0.0",
    "prettier": "^3.3.3",
    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  },
  "jest": {
    "testEnvironment": "jsdom",
    "maxWorkers": "50%",
    "transform": {
      "\\.(js|jsx)$": "babel-jest"
    },
    "testPathIgnorePatterns": [
      "<rootDir>/node_modules/",
      "<rootDir>/.history/",
      "<rootDir>/src/__tests__/utils/"
    ]
  }
}
